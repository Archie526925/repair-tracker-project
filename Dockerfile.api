# ---- Stage 1: Install dependencies ----
FROM node:20-alpine AS deps

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Copy workspace root config files first (for better cache)
COPY pnpm-lock.yaml package.json pnpm-workspace.yaml ./
COPY .npmrc ./

# Copy all package.json files for dependency resolution
COPY artifacts/api-server/package.json artifacts/api-server/package.json
COPY artifacts/repair-tracker/package.json artifacts/repair-tracker/package.json
COPY lib/db/package.json lib/db/package.json
COPY lib/api-zod/package.json lib/api-zod/package.json
COPY lib/api-client-react/package.json lib/api-client-react/package.json
COPY lib/api-spec/package.json lib/api-spec/package.json

# Install all dependencies (frozen lockfile for reproducibility)
RUN pnpm install --frozen-lockfile

# ---- Stage 2: Build ----
FROM deps AS build

# Copy source code for the packages we need to build
COPY lib/api-zod/ lib/api-zod/
COPY lib/api-spec/ lib/api-spec/
COPY lib/db/ lib/db/
COPY lib/api-client-react/ lib/api-client-react/
COPY artifacts/api-server/ artifacts/api-server/

# Build shared libs that api-server depends on (in dependency order)
RUN pnpm --filter @workspace/api-zod build
RUN pnpm --filter @workspace/db build
RUN pnpm --filter @workspace/api-spec build
RUN pnpm --filter @workspace/api-client-react build

# Build the API server
RUN pnpm --filter @workspace/api-server build

# ---- Stage 3: Production run ----
FROM node:20-alpine AS run

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Copy workspace root config for pnpm
COPY pnpm-lock.yaml package.json pnpm-workspace.yaml ./
COPY .npmrc ./

# Copy package.json files
COPY artifacts/api-server/package.json artifacts/api-server/package.json
COPY lib/db/package.json lib/db/package.json
COPY lib/api-zod/package.json lib/api-zod/package.json
COPY lib/api-client-react/package.json lib/api-client-react/package.json
COPY lib/api-spec/package.json lib/api-spec/package.json

# Install production dependencies only
RUN pnpm install --frozen-lockfile --prod

# Copy built output from build stage
COPY --from=build /app/artifacts/api-server/dist/ artifacts/api-server/dist/

# Copy built lib outputs that may be needed at runtime
COPY --from=build /app/lib/db/dist/ lib/db/dist/
COPY --from=build /app/lib/api-zod/dist/ lib/api-zod/dist/
COPY --from=build /app/lib/api-spec/dist/ lib/api-spec/dist/
COPY --from=build /app/lib/api-client-react/dist/ lib/api-client-react/dist/

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

WORKDIR /app/artifacts/api-server

CMD ["node", "--enable-source-maps", "./dist/index.mjs"]
